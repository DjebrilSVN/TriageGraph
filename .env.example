# LLM API Keys (OpenAI by default, or compatible endpoint)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Database (defaults to local SQLite if left empty)
DATABASE_URL=sqlite:///./triage_checkpoints.db

# Human-in-the-loop Policy Thresholds
AUTO_APPROVE_REFUND_MAX=20.00

# Observability (Optional: LangSmith or Langfuse)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key
# LANGCHAIN_PROJECT=TriageGraph
